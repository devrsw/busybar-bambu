{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    /* The device has no DOM; the lib is here for console and the timers. */
    "lib": ["es2020", "dom"],
    /* Asset imports and import.meta.env. */
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Paths */
    "paths": {
      "@shared/*": ["./shared/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* The app, and the platform it builds against. */
  "include": ["./src", "./shared", "./types"]
}
